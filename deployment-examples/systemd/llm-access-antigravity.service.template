[Unit]
Description=StaticFlow Antigravity Data Plane
After=network-online.target mnt-llm\x2daccess.mount
Wants=network-online.target
RequiresMountsFor=/mnt/llm-access

[Service]
Type=simple
User=ts_user
Group=ts_user
TimeoutStartSec=180
EnvironmentFile=/etc/llm-access/llm-access.env
Environment=STATICFLOW_LOG_DIR=/var/log/staticflow-runtime
Environment=STATICFLOW_LOG_SERVICE=llm-access-antigravity
Environment=STATICFLOW_LOG_STDOUT=0
Environment=LLM_ACCESS_CURSOR_STATE_DIR=/var/lib/staticflow/llm-access/antigravity-runtime
Environment=LLM_ACCESS_USAGE_JOURNAL_DIR=/var/lib/staticflow/llm-access/usage-journal
WorkingDirectory=/mnt/llm-access
ExecStartPre=/usr/bin/bash -lc 'set -a; . /mnt/llm-access/config/neon.env; exec /usr/local/bin/staticflow-wait-llm-access-state api'
ExecStart=/usr/bin/bash -lc 'set -a; . /mnt/llm-access/config/neon.env; exec /usr/local/bin/llm-access-antigravity serve --bind 127.0.0.1:19095 --state-root /var/lib/staticflow/llm-access/antigravity-runtime --postgres-control-database-url-env LLM_ACCESS_CONTROL_DATABASE_URL --usage-journal-dir /var/lib/staticflow/llm-access/usage-journal'
Restart=always
RestartSec=3
NoNewPrivileges=true
StateDirectory=staticflow/llm-access
MemoryAccounting=yes
MemoryHigh=1536M
MemoryMax=2048M
MemorySwapMax=512M
TasksMax=192
OOMPolicy=kill

[Install]
WantedBy=multi-user.target
