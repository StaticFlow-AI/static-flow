[Unit]
Description=StaticFlow OAuth Manager
After=network-online.target llm-access.service llm-access-cursor.service
Wants=network-online.target llm-access.service llm-access-cursor.service

[Service]
Type=simple
User=ts_user
Group=ts_user
# Optional admin token; no database credentials.
EnvironmentFile=-/etc/llm-access/oauth.env
ExecStart=/usr/local/bin/llm-access-oauth --bind 127.0.0.1:19194 --codex-admin-url http://127.0.0.1:19080 --cursor-admin-url http://127.0.0.1:19090 --console-url http://127.0.0.1:19191
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
UMask=0077
MemoryAccounting=yes
MemoryHigh=128M
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
